# --- Core (required to run at all) ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/agricarbon
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CLIENT_ORIGIN=http://localhost:5173

# --- Email OTP (Resend). Unset -> OTP is logged to console instead. ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Document storage (IPFS). Unset -> local disk + SHA-256 hash fallback. ---
WEB3_STORAGE_TOKEN=
PINATA_JWT=

# --- Blockchain (Polygon Amoy). Unset -> Mongo-only, chainStatus: not_configured. ---
POLYGON_AMOY_RPC_URL=
DEPLOYER_PRIVATE_KEY=
CARBON_REGISTRY_ADDRESS=

# --- Weather enrichment. Unset -> weather block returns not_configured. ---
OPENWEATHER_API_KEY=

# --- MQTT (optional IoT simulator, manual form is the primary path regardless) ---
MQTT_BROKER_URL=
